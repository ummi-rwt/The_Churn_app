      ],
      "text/plain": [
       "                          accuracy  recall  precision  roc_auc\n",
       "Gradient boosting            0.868   0.585      0.738    0.910\n",
       "Logistic regression          0.805   0.854      0.525    0.902\n",
       "Random forest                0.852   0.700      0.640    0.898\n",
