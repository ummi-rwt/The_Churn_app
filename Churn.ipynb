   "source": [
    "cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\n",
    "metrics = [\"accuracy\", \"recall\", \"precision\", \"roc_auc\"]\n",
    "\n",
    "\n",
    "def evaluate(model_to_test):\n",
    "    scores = cross_validate(model_to_test, X_train, y_train, cv=cv, scoring=metrics)\n",
    "    return {m: round(float(scores[\"test_\" + m].mean()), 3) for m in metrics}\n",
    "\n",
    "\n",
    "logreg = make_pipeline(StandardScaler(), LogisticRegression(max_iter=1000, class_weight=\"balanced\"))\n",
    "forest = RandomForestClassifier(n_estimators=200, class_weight=\"balanced\", random_state=42)\n",
    "boosting = GradientBoostingClassifier(random_state=42)\n",
    "knn = make_pipeline(StandardScaler(), KNeighborsClassifier(n_neighbors=5))\n",
    "svm = make_pipeline(StandardScaler(), SVC(class_weight=\"balanced\"))\n",
    "baseline = DummyClassifier(strategy=\"most_frequent\")\n",
    "\n",
    "all_models = {\n",
    "    \"Gradient boosting\": boosting,\n",
    "    \"Random forest\": forest,\n",
    "    \"Logistic regression\": logreg,\n",
    "    \"SVM (RBF)\": svm,\n",
    "    \"KNN\": knn,\n",
    "    \"Baseline (nobody leaves)\": baseline,\n",
    "}\n",
    "\n",
    "with warnings.catch_warnings():\n",
    "    warnings.simplefilter(\"ignore\")\n",
    "    results = pd.DataFrame({name: evaluate(m) for name, m in all_models.items()}).T\n",
    "\n",
    "results = results.sort_values(\"roc_auc\", ascending=False)\n",
    "results"
   ]
  },
